@model IEnumerable<Readify.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<partial name="_Notification" />

<div class="container w-50">
    <!-- Page Header -->
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center pt-3 mb-3">
        <h2 class="text-primary mb-0">Categories</h2>
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> &nbsp;Add
        </a>
    </div>

    <!-- List of Categories -->
    <div class="card shadow-sm">
        <div class="card-body p-2" >
            <table id="categoryTable" class="table table-striped mb-0 table-responsive">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Volume Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var data in Model)
                    {
                        <tr class="align-middle">
                            <td>@data.strSubject</td>
                            <td>@data.intVolumeNumber</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Category" asp-action="Edit" asp-route-id="@data.intCategoryId"
                                       class="btn btn-sm btn-primary flex-grow-1 flex-md-grow-0">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-controller="Category" asp-action="Delete" asp-route-id="@data.intCategoryId"
                                       class="btn btn-sm btn-danger flex-grow-1 flex-md-grow-0">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
