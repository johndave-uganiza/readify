@model IEnumerable<Readify.Models.Rental>
@using System.Globalization

@{
    ViewData["Title"] = "Rentals";
}

<partial name="_Notification" />
<partial name="_PaymentConfirm" />
<partial name="_PaymentSuccess" />

<div class="container p-2">

    <div class="row pt-2 mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="text-primary">Rentals</h2>
        </div>
        <div class="col-md-6 text-md-end mt-2 mt-md-0">
            <a asp-action="Index" class="btn btn-secondary">Back to Books</a>
        </div>
    </div>

    <div class="row rentals">
        @foreach (var rental in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm border p-1">
                    <div class="card-body d-flex flex-column p-1">
                        @await Html.PartialAsync("_BookImage", rental?.Book?.strImageUrl)
                        <h4 class="card-title mt-2">@rental?.Book?.strTitle</h4>
                        <p class="mb-1"><strong>Rented by:</strong> @rental?.strUserName</p>
                        <p class="mb-1"><strong>Rental Date:</strong> @rental?.dtmRentalDate.ToShortDateString()</p>
                        <p class="mb-2"><strong>Return Date:</strong> @(rental?.dtmReturnDate.ToShortDateString() ?? "Not Returned")</p>
                        <p class="mb-2"><strong>Total Price:</strong> @rental?.dclTotalPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))</p>

                        @{
                            var ysnReturned = rental is not null && rental.ysnReturned;
                            var ysnPaid = rental is not null && rental.ysnPaid;

                            if (ysnReturned) {
                                <span class="badge bg-info mt-auto">Returned (@rental?.strPaymentMethod)</span>
                                <button class="btn btn-secondary btn-sm mt-2" disabled>
                                    Returned
                                </button>
                            } else if (ysnPaid) {
                                <span class="badge bg-success mt-auto">Paid (@rental?.strPaymentMethod)</span>
                            }

                            <div class="mt-auto d-grid">
                                @{
                                  if (!ysnReturned) {
                                        <button type="button"
                                                class="btn btn-info btn-sm mt-2 returnRentalBtn"
                                                data-rental-id="@rental?.intRentalId">
                                            Return
                                        </button>
                                  }
                                 }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <form id="returnForm" asp-action="Return" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="intRentalId" />
    </form>
</div>

@section Scripts {
    <script src="~/js/Rent.js"></script>
}