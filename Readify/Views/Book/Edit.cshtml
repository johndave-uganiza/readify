@model Readify.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4 w-50">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title mb-4">Edit Book</h2>
            <hr />
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row mb-3">
                    <div class="col-lg-6 col-md-12 d-flex flex-column justify-content-between">
                        <input type="hidden" asp-for="intBookId" />
                        <div class="col-12">
                            <label asp-for="strTitle" class="form-label"></label>
                            <input asp-for="strTitle" class="form-control" />
                            <span asp-validation-for="strTitle" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="strAuthor" class="form-label"></label>
                            <input asp-for="strAuthor" class="form-control" />
                            <span asp-validation-for="strAuthor" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="intCategoryId" class="form-label">Category</label>
                            <select asp-for="intCategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                                <option value="" disabled selected>-- Select Category --</option>
                            </select>
                            <span asp-validation-for="intCategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="dclPrice" class="form-label"></label>
                            <input asp-for="dclPrice" class="form-control" />
                            <span asp-validation-for="dclPrice" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-12 d-flex flex-column justify-content-between">
                        <div class="col-12">
                            <label class="form-label">Book Image</label>
                            @if (!string.IsNullOrEmpty(Model.strImageUrl))
                            {
                                <div class="mb-2">
                                    @await Html.PartialAsync("_BookImage", Model.strImageUrl)
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No image uploaded</p>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label">Change Image</label>
                            <input type="file"
                                   name="imageFile"
                                   id="imageFile"
                                   class="form-control"
                                   accept="image/*" />
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                     <button type="submit" class="btn btn-primary">Update</button>
                     <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const fileInput = document.getElementById('imageFile');
        const imagePreview = document.getElementById('imagePreview');

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}

