@model IEnumerable<Readify.Models.Book>
@using System.Globalization

@{
    ViewData["Title"] = "Books";
}

<partial name="_Notification" />

<div class="container p-3">
    <!-- Page Header -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="text-primary">Books</h2>
        </div>
        <div class="col-md-6 text-md-end mt-2 mt-md-0">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp;Add
            </a>
        </div>
    </div>

    <!-- List of Books -->
    <div class="row g-2">
        @foreach (var book in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm border p-1">
                    <div class="card-body d-flex flex-column p-1">
                        @await Html.PartialAsync("_BookImage", book.strImageUrl)
                        <h4 class="card-title mt-2">@book.strTitle</h4>

                        <p class="card-text mb-1">
                            <strong>Author:</strong> @book.strAuthor
                        </p>

                        <p class="card-text mb-1">
                            <strong>Subject:</strong> @book.Category?.strSubject
                        </p>

                        <p class="card-text fw-bold mb-2">
                            <strong>Price:</strong> @book.dclPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))
                        </p>

                        <div class="mt-auto d-grid gap-2">
                            <a asp-action="Detail"
                               asp-route-id="@book.intBookId"
                               class="btn btn-primary btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@book.intBookId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@book.intBookId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
