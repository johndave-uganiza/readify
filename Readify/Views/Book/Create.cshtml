@model Readify.Models.Book

@{
    ViewData["Title"] = "Add Book";
}

<div class="container mt-4 w-50">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title mb-4">Add New Book</h2>
            <hr />
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="strTitle" class="form-label"></label>
                        <input asp-for="strTitle" class="form-control" />
                        <span asp-validation-for="strTitle" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="strAuthor" class="form-label"></label>
                        <input asp-for="strAuthor" class="form-control" />
                        <span asp-validation-for="strAuthor" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="intCategoryId" class="form-label">Category</label>
                        <select asp-for="intCategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="intCategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="dclPrice" class="form-label"></label>
                        <input asp-for="dclPrice" class="form-control" />
                        <span asp-validation-for="dclPrice" class="text-danger"></span>
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="mb-3">
                    <label class="form-label">Book Image</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
